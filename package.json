{
  "name": "mlbb-meta",
  "private": true,
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "scripts": {
    "deploy": "npm run build && tgcloud push",
    "status": "tgcloud status",
    "run": "tgcloud run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build --emptyOutDir",
    "test": "node --test tests/domain.test.mjs",
    "test:integration": "node --import ./tests/register.mjs --test tests/backend.test.mjs",
    "check": "npm test && npm run test:integration && npm run test:importer && npm run build && node scripts/check-runtime.mjs",
    "normalize": "node scripts/normalize.mjs",
    "data:fetch": "python3 scripts/fetch-data.py",
    "test:importer": "python3 tests/importer_test.py"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "type": "module"
}
